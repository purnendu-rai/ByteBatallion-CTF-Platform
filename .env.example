# ByteBatallion configuration — copy to .env and edit. NEVER commit .env.

# Secret used to sign session cookies (used from Phase 1). Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# Database. SQLite for development; moving to PostgreSQL later is only a URL change.
DATABASE_URL=sqlite:///./data/bytebatallion.db

# Server
HOST=127.0.0.1
PORT=8000
DEBUG=false

# dev | prod — "prod" enables the Secure flag on session cookies
ENVIRONMENT=dev
