# ByteBatallion configuration — copy to .env and edit. NEVER commit .env.

# Secret used to sign session cookies (used from Phase 1). Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# Database. SQLite for development; moving to PostgreSQL later is only a URL change.
DATABASE_URL=sqlite:///./data/bytebatallion.db

# Server
HOST=127.0.0.1
PORT=8000
DEBUG=false

# dev | prod — "prod" enables the Secure flag on session cookies
ENVIRONMENT=dev

# First-admin bootstrap (v3.1) — only needed on hosts without shell access
# (e.g. Render free tier). When all three are set, the app creates this
# admin on startup if the username is not already taken. Leave unset
# locally; set real values only in the host dashboard, never here.
#BOOTSTRAP_ADMIN_USERNAME=
#BOOTSTRAP_ADMIN_EMAIL=
#BOOTSTRAP_ADMIN_PASSWORD=
